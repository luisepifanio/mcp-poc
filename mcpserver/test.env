#Mandatory settings
ENV=test

# Redis Configuration (use different port to avoid collision with dev)
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380
LOG_LEVEL=DEBUG
# Use in-memory SQLite with shared cache for tests (allows multiple connections to share same DB instance)
database_url=sqlite+aiosqlite:///file:memdb?mode=memory&cache=shared&uri=true
# Extras